# Variables de la fonction /api/lead.
#
# En local : copier ce fichier en `.env` (ignoré par git) pour `npm run ghl:check`.
# En production : les poser dans Vercel > Settings > Environment Variables, jamais ici.
# Aucune de ces valeurs n'atteint le navigateur. Ne jamais en préfixer une de
# NEXT_PUBLIC_, et ne jamais en recopier une dans lib/config.ts, qui part côté client.

# Requis. Le Private Integration token du sous-compte AZ Motorsport :
# GHL > Settings > Private Integrations > créer un jeton avec les scopes
# contacts (read/write), opportunities (read/write). Il commence par pit-.
GHL_API_KEY=

# Requis. L'id du sous-compte, visible dans l'URL GHL
# (app.gohighlevel.com/location/<CECI>/...) ou sous Settings > Business Profile.
GHL_LOCATION_ID=

# Où atterrit l'opportunité. Deux façons, au choix :
#
#   a) par id — un appel d'API de moins par lead froid, et rien ne bouge si le
#      pipeline est renommé. `npm run ghl:check` imprime les ids.
GHL_PIPELINE_ID=
GHL_STAGE_ID=
#
#   b) par nom — plus lisible, résolu au premier lead puis gardé en mémoire.
#      Ignoré si les ids ci-dessus sont remplis.
GHL_PIPELINE_NAME=
GHL_STAGE_NAME=
#
# Si les quatre restent vides : premier pipeline du sous-compte, première étape.
# Acceptable pour un test, à ne pas laisser en campagne.

# Optionnel. Le champ personnalisé d'opportunité qui reçoit le courriel du client
# ({{opportunity.customer_email}}). Vide = envoyé par sa clé, opportunity.customer_email.
# Si GHL ne le remplit pas, coller ici l'id du champ (Settings > Custom Fields).
GHL_OPP_EMAIL_FIELD_ID=

# Optionnel. Origines autorisées à poster sur /api/lead, séparées par des virgules.
# Vide = toute origine (la page est de toute façon servie sur le même domaine).
#
# Avec ou sans schéma, les deux marchent : « https://fitment.azmotorsport.ca » comme
# « fitment.azmotorsport.ca » ou « localhost:3000 ». Le port compte, le schéma non.
# Une entrée qui ne correspond à rien ne prévient pas : les leads partent en 403 et
# seule la console du visiteur le dit. Après un changement ici, envoyer un vrai lead.
#
#   https://azm-landing.vercel.app,https://fitment.azmotorsport.ca,localhost:3000
ALLOWED_ORIGINS=

# Optionnel. Vise une autre base que l'API GHL — un bouchon local, pour vérifier le
# parcours de bout en bout sans écrire un faux contact dans le CRM de production.
# À laisser VIDE partout ailleurs, et surtout dans Vercel.
#   GHL_API_ROOT=http://localhost:4555
GHL_API_ROOT=

# Optionnel. Override de l'en-tête Version de l'API GHL. Défaut 2021-07-28.
# À ne toucher que si un endpoint renvoie une erreur de version.
GHL_API_VERSION=

# Optionnel. "1" renvoie le détail de l'erreur upstream dans la réponse HTTP.
# Utile en préproduction, à laisser vide en production.
LEAD_DEBUG=
